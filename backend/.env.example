# ─────────────────────────────────────────────────────────
#  RoadReady Backend – Environment Variables Template
#  Copy this file to .env and fill in your own values.
#  NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB – replace with your Atlas URI or local connection string
# Atlas example:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/roadready?retryWrites=true&w=majority
# Local example:  mongodb://localhost:27017/roadready
MONGO_URI=mongodb://localhost:27017/roadready

# JWT – use a long, random string (at least 32 chars)
JWT_SECRET=replace_this_with_a_long_random_secret_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# CORS – URL of the React frontend (Vite default)
CLIENT_ORIGIN=http://localhost:5173

# Weather API (optional: if omitted or invalid, automatically falls back to Open-Meteo meteorological API)
WEATHER_API_KEY=

# Razorpay Payment Gateway (TEST MODE ONLY)
# Obtain test credentials from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google OAuth 2.0 / OpenID Connect (Authorization Code Flow with PKCE)
# Obtain credentials from Google Cloud Console:
# 1. Create a project at https://console.cloud.google.com/
# 2. Go to APIs & Services > Credentials > Create Credentials > OAuth client ID
# 3. Application type: Web application
# 4. Authorized redirect URIs:
#    - Development: http://localhost:5000/api/auth/google/callback
#    - Production:  https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

